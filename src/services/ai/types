// ============================================
// AI Module Types
// ============================================
// All TypeScript interfaces for the AI scanning feature.

// ============================================
// Document Types
// ============================================
export type DocumentType = 'credit_invoice' | 'payment_receipt' | 'bank_receipt' | 'unknown';

export interface ClassificationResult {
  documentType: DocumentType;
  documentTypeConfidence: number;
  classificationReason: string;
  needsManualClassification: boolean;
}

// ============================================
// Extracted Data Types
// ============================================
export interface ExtractedItem {
  item_name: string;
  quantity: number;
  unit: string;
  rate: number;
  amount: number;
}

export interface ExtractedCreditData {
  customer_name: string;
  phone_number: string;
  invoice_number: string;
  invoice_date: string;
  items: ExtractedItem[];
  subtotal: number;
  discount: number;
  tax: number;
  grand_total: number;
  notes: string;
}

export interface ExtractedPaymentData {
  customer_name: string;
  payment_amount: number;
  payment_date: string;
  payment_method: string;
  reference_number: string;
  upi_id: string;
  bank_name: string;
  notes: string;
}

export type ExtractedData = ExtractedCreditData | ExtractedPaymentData | null;

// ============================================
// Customer Matching Types
// ============================================
export interface CustomerMatch {
  id: string;
  name: string;
  customer_code: string;
  phone: string;
  customer_type: string;
  match_type: 'exact' | 'similar' | 'none';
  match_score: number;
  match_reason: string;
}

// ============================================
// Confidence Scores
// ============================================
export type ConfidenceScores = Record<string, number>;

// ============================================
// Complete AI Scan Result
// ============================================
export interface AIScanResult {
  documentType: DocumentType;
  documentTypeConfidence: number;
  classificationReason: string;
  extractedData: ExtractedData;
  customerMatches: CustomerMatch[];
  confidence: ConfidenceScores;
  fileUrl: string;
  fileType: 'image' | 'pdf';
  error?: string;
}

// ============================================
// Processing Step (for progress UI)
// ============================================
export type ProcessingStep =
  | 'uploading'
  | 'reading'
  | 'classifying'
  | 'extracting'
  | 'matching'
  | 'preparing';

export interface ProcessingState {
  step: ProcessingStep;
  message: string;
  progress: number; // 0-100
}

// ============================================
// Scan Store State (Zustand)
// ============================================
export interface AIScanStore {
  // Current scan result
  scanResult: AIScanResult | null;
  isScanning: boolean;
  processingState: ProcessingState | null;
  error: string | null;

  // Actions
  setScanResult: (result: AIScanResult | null) => void;
  setIsScanning: (isScanning: boolean) => void;
  setProcessingState: (state: ProcessingState | null) => void;
  setError: (error: string | null) => void;
  clearScan: () => void;
}

// ============================================
// API Request/Response Types
// ============================================
export interface AIScanRequest {
  file_url: string;
  file_type: 'image' | 'pdf';
}

export interface AIScanResponse {
  documentType: DocumentType;
  documentTypeConfidence: number;
  classificationReason: string;
  extractedData: ExtractedData;
  customerMatches: CustomerMatch[];
  confidence: ConfidenceScores;
  fileUrl: string;
  fileType: 'image' | 'pdf';
  needsManualClassification?: boolean;
  error?: string;
}