const providerName = Deno.env.get('AI_PROVIDER') || 'qwen';
```

**Frontend (`src/services/ai/config.ts`):**
```typescript
export const AI_CONFIG = {
  provider: 'qwen', // Change this to: 'gemini' | 'claude' | 'gpt' | 'llama' | 'deepseek'
  // ...
};
```

