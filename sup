// ============================================
// QwenCloud Provider Implementation
// ============================================
// Uses the official QwenCloud Multimodal Generation API
// https://dashscope-intl.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
//
// Configuration (set as Supabase Edge Function secrets):
//   QWEN_API_KEY  - API key for authentication
//   QWEN_MODEL    - Model name (defaults to "qwen3.5-flash")
//
// Image Handling:
//   - Receives storage path from edge function
//   - Generates signed URL (valid for 1 hour)
//   - Sends signed URL to QwenCloud (never exposes public URLs)

import { AIProvider } from './ai-provider.ts';

export class QwenProvider implements AIProvider {
  private apiUrl: string;
  private apiKey: string;
  private model: string;

  constructor() {
    // QwenCloud Multimodal Generation API endpoint
    this.apiUrl = 'https://dashscope-intl.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation';
    this.apiKey = Deno.env.get('QWEN_API_KEY') || '';
    this.model = Deno.env.get('QWEN_MODEL') || 'qwen3.5-flash';

    if (!this.apiKey) {
      throw new Error(
        'QWEN_API_KEY must be configured as an Edge Function secret'
      );
    }
  }

  /**
   * Analyze a document using QwenCloud API
   * @param fileBytes - The file bytes (used to generate signed URL)
   * @param mimeType - MIME type of the file
   * @param prompt - The prompt to send to the AI
   * @param storagePath - The Supabase Storage path (bucket/path)
   */
  async analyzeDocument(
    fileBytes: Uint8Array,
    mimeType: string,
    prompt: string,
    storagePath?: string
  ): Promise<string> {
    const startTime = Date.now();
    console.log(`[QwenProvider] Request started - Model: ${this.model}, MIME: ${mimeType}`);

    try {
      // Generate signed URL if storage path is provided
      let imageUrl: string;
      if (storagePath) {
        imageUrl = await this.generateSignedUrl(storagePath);
        console.log(`[QwenProvider] Generated signed URL for: ${storagePath}`);
      } else {
        // Fallback to base64 (for backward compatibility)
        imageUrl = `data:${mimeType};base64,${this.base64Encode(fileBytes)}`;
        console.log(`[QwenProvider] Using base64 encoding (fallback)`);
      }

      // Prepare request body according to QwenCloud API format
      const requestBody = {
        model: this.model,
        messages: [
          {
            role: 'user',
            content: [
              {
                type: 'text',
                text: prompt,
              },
              {
                type: 'image_url',
                image_url: {
                  url: imageUrl,
                },
              },
            ],
          },
        ],
        temperature: 0,
        max_tokens: 4096,
      };

      console.log(`[QwenProvider] Sending request to QwenCloud...`);

      // Make request with 60-second timeout and retry logic
      const response = await this.requestWithRetry(this.apiUrl, requestBody);

      const responseTime = Date.now() - startTime;
      console.log(`[QwenProvider] Response received in ${responseTime}ms`);

      // Extract content from response
      const content = this.extractContent(response);

      // Log token usage if available
      if (response.usage) {
        console.log(`[QwenProvider] Token usage - Prompt: ${response.usage.prompt_tokens}, Completion: ${response.usage.completion_tokens}, Total: ${response.usage.total_tokens}`);
      }

      console.log(`[QwenProvider] Request completed successfully`);
      return content;
    } catch (error: any) {
      const responseTime = Date.now() - startTime;
      console.error(`[QwenProvider] Request failed after ${responseTime}ms:`, error.message);
      throw error;
    }
  }

  /**
   * Generate a signed URL for Supabase Storage
   */
  private async generateSignedUrl(storagePath: string): Promise<string> {
    // Parse storage path (format: "bucket/path/to/file")
    const pathParts = storagePath.split('/');
    if (pathParts.length < 2) {
      throw new Error(`Invalid storage path format: ${storagePath}`);
    }

    const bucket = pathParts[0];
    const filePath = pathParts.slice(1).join('/');

    // Create Supabase client with service role
    const supabaseUrl = Deno.env.get('SUPABASE_URL')!;
    const supabaseServiceKey = Deno.env.get('SUPABASE_SERVICE_ROLE_KEY')!;

    // Import Supabase client dynamically
    const { createClient } = await import('https://esm.sh/@supabase/supabase-js@2');
    const supabase = createClient(supabaseUrl, supabaseServiceKey);

    // Generate signed URL (valid for 1 hour)
    const { data, error } = await supabase.storage
      .from(bucket)
      .createSignedUrl(filePath, 3600);

    if (error || !data?.signedUrl) {
      throw new Error(`Failed to generate signed URL: ${error?.message || 'Unknown error'}`);
    }

    return data.signedUrl;
  }

  /**
   * Make HTTP request with retry logic
   */
  private async requestWithRetry(
    url: string,
    body: any,
    retryCount: number = 1
  ): Promise<any> {
    const controller = new AbortController();
    const timeoutId = setTimeout(() => controller.abort(), 60000); // 60-second timeout

    try {
      const response = await fetch(url, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${this.apiKey}`,
        },
        body: JSON.stringify(body),
        signal: controller.signal,
      });

      clearTimeout(timeoutId);

      // Handle specific error codes
      if (!response.ok) {
        const errorText = await response.text();
        let errorMsg: string;

        try {
          const errorJson = JSON.parse(errorText);
          errorMsg = errorJson.error?.message || errorJson.error || `HTTP ${response.status}`;
        } catch {
          errorMsg = `HTTP ${response.status}: ${errorText.substring(0, 200)}`;
        }

        // Handle specific HTTP status codes
        switch (response.status) {
          case 401:
            console.error('[QwenProvider] Authentication failed - Invalid API key');
            throw new Error('Invalid API key. Please check QWEN_API_KEY configuration.');
          case 403:
            console.error('[QwenProvider] Forbidden - Check API permissions');
            throw new Error('Access forbidden. Please check your QwenCloud API permissions.');
          case 429:
            console.error('[QwenProvider] Rate limit exceeded');
            if (retryCount > 0) {
              console.log(`[QwenProvider] Retrying after rate limit...`);
              await this.delay(2000);
              return this.requestWithRetry(url, body, retryCount - 1);
            }
            throw new Error('Rate limit exceeded. Please try again later.');
          case 500:
            console.error('[QwenProvider] Server error');
            if (retryCount > 0) {
              console.log(`[QwenProvider] Retrying after server error...`);
              await this.delay(1000);
              return this.requestWithRetry(url, body, retryCount - 1);
            }
            throw new Error('QwenCloud server error. Please try again.');
          default:
            throw new Error(errorMsg);
        }
      }

      const data = await response.json();

      // Check for API-level errors
      if (data.error) {
        const errorMsg = data.error.message || data.error.code || 'Unknown API error';
        console.error(`[QwenProvider] API error:`, errorMsg);
        throw new Error(`QwenCloud API error: ${errorMsg}`);
      }

      return data;
    } catch (error: any) {
      clearTimeout(timeoutId);

      if (error?.name === 'AbortError') {
        console.error(`[QwenProvider] Request timed out after 60 seconds`);
        throw new Error('AI request timed out after 60 seconds. Please try again with a clearer image.');
      }

      // Don't retry authentication or client errors
      if (error.message.includes('API key') || error.message.includes('Invalid')) {
        throw error;
      }

      // Retry once for network errors or 5xx
      if (retryCount > 0 && !error.message.includes('HTTP 4')) {
        console.log(`[QwenProvider] Retrying after error: ${error.message}`);
        await this.delay(1000);
        return this.requestWithRetry(url, body, retryCount - 1);
      }

      throw error;
    }
  }

  /**
   * Extract content from QwenCloud response
   */
  private extractContent(response: any): string {
    // QwenCloud response format:
    // {
    //   "output": {
    //     "choices": [
    //       {
    //         "message": {
    //           "content": "text response"
    //         }
    //       }
    //     ]
    //   },
    //   "usage": {...}
    // }

    const content = response?.output?.choices?.[0]?.message?.content;

    if (!content) {
      throw new Error('QwenCloud API returned empty response content');
    }

    if (typeof content === 'string') {
      return content;
    }

    // Handle array content (multimodal responses)
    if (Array.isArray(content)) {
      const textBlocks = content
        .filter((block: any) => block.type === 'text')
        .map((block: any) => block.text)
        .join('\n');
      
      if (textBlocks) {
        return textBlocks;
      }
    }

    throw new Error('QwenCloud API returned unexpected response format');
  }

  /**
   * Base64 encode bytes
   */
  private base64Encode(bytes: Uint8Array): string {
    const chunkSize = 0x8000;
    const chunks: string[] = [];
    for (let i = 0; i < bytes.length; i += chunkSize) {
      const chunk = bytes.subarray(i, i + chunkSize);
      chunks.push(String.fromCharCode(...chunk));
    }
    if (typeof btoa !== 'undefined') {
      return btoa(chunks.join(''));
    }
    return this.btoaFallback(chunks.join(''));
  }

  /**
   * Fallback base64 encoding for Deno
   */
  private btoaFallback(str: string): string {
    const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/';
    let result = '';
    let i = 0;
    while (i < str.length) {
      const byte1 = str.charCodeAt(i++) & 0xff;
      const byte2 = i < str.length ? str.charCodeAt(i++) & 0xff : NaN;
      const byte3 = i < str.length ? str.charCodeAt(i++) & 0xff : NaN;
      result += chars[byte1 >> 2];
      result += isNaN(byte2) ? '=' : chars[((byte1 & 0x03) << 4) | (byte2 >> 4)];
      result += isNaN(byte3) ? '=' : chars[((byte2 & 0x0f) << 2) | (byte3 >> 6)];
      result += isNaN(byte3) ? '=' : chars[byte3 & 0x3f];
    }
    return result;
  }

  /**
   * Delay utility for retries
   */
  private delay(ms: number): Promise<void> {
    return new Promise(resolve => setTimeout(resolve, ms));
  }
}

/**
 * Health check function to verify QwenCloud integration
 */
export async function checkQwenHealth(): Promise<{
  provider: string;
  model: string;
  latency: number;
  success: boolean;
  error?: string;
}> {
  const startTime = Date.now();
  const provider = 'QwenCloud';
  const model = Deno.env.get('QWEN_MODEL') || 'qwen3.5-flash';

  try {
    // Simple test request with a minimal image
    const testImageBase64 = 'iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNk+M9QDwADhgGAWjR9awAAAABJRU5ErkJggg==';
    const testPrompt = 'What is this image? Respond with only "test"';

    const qwenProvider = new QwenProvider();
    await qwenProvider.analyzeDocument(
      new Uint8Array(),
      'image/png',
      testPrompt
    );

    const latency = Date.now() - startTime;

    return {
      provider,
      model,
      latency,
      success: true,
    };
  } catch (error: any) {
    const latency = Date.now() - startTime;
    return {
      provider,
      model,
      latency,
      success: false,
      error: error.message,
    };
  }
}